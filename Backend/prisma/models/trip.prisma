model Trip {
  id          Int        @id @default(autoincrement())
  bus_id      Int
  start_time  DateTime
  end_time    DateTime?
  status      TripStatus @default(SCHEDULED)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  bus         Bus        @relation(fields: [bus_id], references: [id], onDelete: Cascade)

  tickets     Ticket[]
  packages    Package[]
}

