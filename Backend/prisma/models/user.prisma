model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String?    @unique
  password     String?
  phone        String     @unique
  role         Role       @default(owner)
  company_name String?
  is_verified  Boolean    @default(false)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  // Relation to UserExtra - foreign key on UserExtra only, so no fields/references here
  userExtra    UserExtra?

  // Relations for Bus and Trip driver/conductor
  busesDriven    Bus[]    @relation("BusDriver")
  busesConducted Bus[]    @relation("BusConductor")

  tripsDriven    Trip[]   @relation("TripDriver")
  tripsConducted Trip[]   @relation("TripConductor")

  // Other relations
  routes       Route[]
  buses        Bus[]
  otps         OTP[]
}

model UserExtra {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String?   @db.VarChar(100)
  license_number    String?   @db.VarChar(50)
  license_expiry    DateTime?
  experience_years  Int       @default(0)
  address           String?   @db.Text
  emergency_contact String?   @db.VarChar(15)
  active            Boolean   @default(true)

  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
}

model OTP {
  id         Int      @id @default(autoincrement())
  user_id    Int
  otp_code   String
  otp_type   OTPType
  expires_at DateTime
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum OTPType {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

enum Role {
  owner
  admin
  conductor
  driver
}
